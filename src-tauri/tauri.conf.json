{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskflow DDC",
  "version": "0.2.4",
  "identifier": "app.deskflow-ddc.preview",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "dragDropEnabled": true,
        "title": "Deskflow DDC",
        "width": 1120,
        "height": 800,
        "minWidth": 860,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icons/app.png",
      "../resources/icons/app.icns",
      "../resources/icons/app.ico"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installerHooks": "../native/windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "ddcutil",
          "i2c-tools",
          "libx11-6",
          "libxrandr2",
          "libxtst6",
          "libxkbfile1",
          "libxi6",
          "libxinerama1",
          "libice6",
          "libsm6",
          "libxkbcommon0",
          "libxkbcommon-x11-0",
          "libxkbregistry0",
          "libxcb-cursor0",
          "libxcb-icccm4",
          "libxcb-keysyms1",
          "libxcb-image0",
          "libxcb-render-util0",
          "libxcb-xinerama0",
          "libxcb-xkb1",
          "libxcb-shape0",
          "libegl1",
          "libgl1",
          "libfontconfig1",
          "libdbus-1-3",
          "libsecret-1-0",
          "gnome-keyring",
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "libssl3t64",
          "libdouble-conversion3",
          "libpcre2-16-0",
          "libmd4c0",
          "libzstd1",
          "zlib1g",
          "libharfbuzz0b",
          "libfreetype6"
        ]
      }
    }
  },
  "mainBinaryName": "deskflow-ddc"
}
